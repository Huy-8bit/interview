# =============================================================================
# PostgreSQL Lab - environment variables
# Copy to .env and adjust:  cp .env.example .env
# Every variable has a default in docker-compose.yml, so .env is optional.
# =============================================================================

# ---- Host binding ------------------------------------------------------------
# 127.0.0.1 = only reachable from this machine (recommended for a lab with
# weak passwords). Use 0.0.0.0 to reach the databases from other machines.
BIND_ADDRESS=127.0.0.1
PRIMARY_PORT=55435
REPLICA_PORT=55436
REPLICA_2_PORT=55437

# ---- Superuser / application database ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# ---- LockLens ---------------------------------------------------------------
# Generate unique values before starting:
#   openssl rand -hex 32          # store and administrator passwords
#   openssl rand -base64 32       # master key (keep it; it encrypts saved DSNs)
LOCKLENS_VERSION=latest
LOCKLENS_STORE_PASSWORD=replace-with-a-random-hex-password
LOCKLENS_MASTER_KEY=replace-with-output-of-openssl-rand-base64-32
LOCKLENS_ADMIN_USER=admin
LOCKLENS_ADMIN_PASSWORD=replace-with-a-random-hex-password
LOCKLENS_COOKIE_SECURE=false
LOCKLENS_HTTP_PORT=8080

# ---- Synthetic workload (35 DB clients by default) --------------------------
WORKLOAD_PRIMARY_CLIENTS=40
WORKLOAD_PRIMARY_JOBS=10
WORKLOAD_REPLICA_1_CLIENTS=20
WORKLOAD_REPLICA_1_JOBS=8
WORKLOAD_REPLICA_2_CLIENTS=20
WORKLOAD_REPLICA_2_JOBS=8
# pgbench run duration; 31536000 seconds = 1 year, stop manually with compose.
WORKLOAD_DURATION_SECONDS=31536000

# ---- Streaming replication -----------------------------------------------------
# Dedicated role with the REPLICATION attribute (not the superuser).
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_pass
# Physical replication slot the replica streams from.
REPLICATION_SLOT=replica_1_slot
REPLICATION_SLOT_2=replica_2_slot

# ---- PostgreSQL shared memory -----------------------------------------------
# /dev/shm limit per PostgreSQL container (large parallel VACUUM/index jobs).
# Increase only if the Docker VM has enough RAM; this is a capacity limit,
# not memory reserved up front.
POSTGRES_SHM_SIZE=2gb

# ---- Data generator ------------------------------------------------------------
# Set AUTO_GENERATE=false to skip data generation on `docker compose up`.
AUTO_GENERATE=true
# true = TRUNCATE all tables and regenerate even if data already exists.
RESET_DATA=false
SEED=42
# Reference "now" for generated timestamps (ISO 8601, e.g. 2026-10-01T00:00:00Z).
# Empty = time of the run. Same SEED + same DATA_NOW -> byte-identical data.
DATA_NOW=
BATCH_SIZE=10000
FAKER_LOCALE=en_US

NUM_USERS=100000
NUM_PRODUCTS=100000
NUM_ORDERS=500000
# Target number of order lines (average items per order = NUM_ORDER_ITEMS / NUM_ORDERS)
NUM_ORDER_ITEMS=1500000
NUM_INVENTORY=100000
NUM_REVIEWS=300000
# Share of orders placed by "heavy" users (HEAVY_USER_SHARE of all users)
HEAVY_USER_SHARE=0.20
HEAVY_USER_ORDER_SHARE=0.70
