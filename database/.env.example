# =============================================================================
# PostgreSQL Lab - environment variables
# Copy to .env and adjust:  cp .env.example .env
# Every variable has a default in docker-compose.yml, so .env is optional.
# =============================================================================

# ---- Host binding ------------------------------------------------------------
# 127.0.0.1 = only reachable from this machine (recommended for a lab with
# weak passwords). Use 0.0.0.0 to reach the databases from other machines.
BIND_ADDRESS=127.0.0.1
PRIMARY_PORT=5432
REPLICA_PORT=5433

# ---- Superuser / application database ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# ---- Streaming replication -----------------------------------------------------
# Dedicated role with the REPLICATION attribute (not the superuser).
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_pass
# Physical replication slot the replica streams from.
REPLICATION_SLOT=replica_1_slot

# ---- Data generator ------------------------------------------------------------
# Set AUTO_GENERATE=false to skip data generation on `docker compose up`.
AUTO_GENERATE=true
# true = TRUNCATE all tables and regenerate even if data already exists.
RESET_DATA=false
SEED=42
BATCH_SIZE=10000
FAKER_LOCALE=en_US

NUM_USERS=100000
NUM_PRODUCTS=100000
NUM_ORDERS=500000
# Target number of order lines (average items per order = NUM_ORDER_ITEMS / NUM_ORDERS)
NUM_ORDER_ITEMS=1500000
NUM_INVENTORY=100000
NUM_REVIEWS=300000
# Share of orders placed by "heavy" users (HEAVY_USER_SHARE of all users)
HEAVY_USER_SHARE=0.20
HEAVY_USER_ORDER_SHARE=0.70
