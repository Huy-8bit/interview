# Defaults are for a local lab. Changing an initialized database password also
# requires ALTER ROLE; changing this file alone does not change existing volumes.
COMPOSE_PROJECT_NAME=vehicle-platform-lab
POSTGRES_PASSWORD=lab_admin_password
VEHICLE_DB_PASSWORD=vehicle_password
WARRANTY_DB_PASSWORD=warranty_password
INSPECTION_DB_PASSWORD=inspection_password
REPAIR_DB_PASSWORD=repair_password
VEHICLE_PORT=8001
WARRANTY_PORT=8002
INSPECTION_PORT=8003
REPAIR_PORT=8004
KAFKA_UI_PORT=8080
LOG_LEVEL=INFO
CACHE_TTL=60
IDEMPOTENCY_TTL=86400
LOCK_TIMEOUT=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=10000
REDIS_TIMEOUT=0.5
HTTP_CONNECT_TIMEOUT=1
HTTP_TIMEOUT=2
HTTP_MAX_CONNECTIONS=20
HTTP_RETRIES=2
OUTBOX_INTERVAL=0.5
OUTBOX_RETRY_MAX_SECONDS=60
KAFKA_SEND_TIMEOUT=5
CONSUMER_MAX_RETRIES=4
RETRY_BASE_SECONDS=1
CONSUMER_MAX_POLL_INTERVAL_MS=300000
KAFKA_TOPIC_PARTITIONS=3
DEFAULT_WARRANTY_DAYS=1095
WARRANTY_EXPIRY_INTERVAL=30
LAB_MODE=false
# DATABASE_URL, REDIS_URL, KAFKA_BOOTSTRAP_SERVERS, SERVICE_NAME,
# KAFKA_CONSUMER_GROUP and WARRANTY_SERVICE_URL are assigned per container
# in docker-compose.yml. Override them in a compose override for external infra.
