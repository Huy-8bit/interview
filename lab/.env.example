# Defaults are for a local lab. Changing an initialized database password also
# requires ALTER ROLE; changing this file alone does not change existing volumes.
COMPOSE_PROJECT_NAME=vehicle-platform-lab
POSTGRES_PASSWORD=lab_admin_password
VEHICLE_DB_PASSWORD=vehicle_password
WARRANTY_DB_PASSWORD=warranty_password
INSPECTION_DB_PASSWORD=inspection_password
REPAIR_DB_PASSWORD=repair_password
VEHICLE_READ_PASSWORD=vehicle_read_password
WARRANTY_READ_PASSWORD=warranty_read_password
INSPECTION_READ_PASSWORD=inspection_read_password
REPAIR_READ_PASSWORD=repair_read_password
REPLICATION_PASSWORD=replication_password
DEBEZIUM_PASSWORD=debezium_password
CONNECT_PORT=8083
CONNECT_HEAP_OPTS=-Xms256M -Xmx512M
DB_READ_TIMEOUT=3
VEHICLE_PORT=8001
WARRANTY_PORT=8002
INSPECTION_PORT=8003
REPAIR_PORT=8004
REPAIR_PORT_END=8006
# Redis nodes use .11 through .16 on this dedicated /24 Docker subnet.
REDIS_SUBNET_PREFIX=172.29.86
KAFKA_CLUSTER_ID=q1Sh-9_ISia_zwGINzRvyQ
KAFKA_HEAP_OPTS=-Xmx384M -Xms256M
KAFKA_UI_PORT=8080
LOG_LEVEL=INFO
CACHE_TTL=60
IDEMPOTENCY_TTL=86400
LOCK_TIMEOUT=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=10000
REDIS_TIMEOUT=0.5
REDIS_OPERATION_TIMEOUT=2
HTTP_CONNECT_TIMEOUT=1
HTTP_TIMEOUT=2
HTTP_MAX_CONNECTIONS=20
HTTP_RETRIES=2
OUTBOX_INTERVAL=0.5
OUTBOX_RETRY_MAX_SECONDS=60
KAFKA_SEND_TIMEOUT=5
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_RETRY_BACKOFF_MS=200
CONSUMER_MAX_RETRIES=4
RETRY_BASE_SECONDS=1
CONSUMER_MAX_POLL_INTERVAL_MS=300000
CONSUMER_FETCH_TIMEOUT=15
CONSUMER_STALL_TIMEOUT=15
KAFKA_TOPIC_PARTITIONS=3
DEFAULT_WARRANTY_DAYS=1095
WARRANTY_EXPIRY_INTERVAL=30
LAB_MODE=false
# WRITE_DATABASE_URL, READ_DATABASE_URL, REDIS_CLUSTER_NODES, KAFKA_BOOTSTRAP_SERVERS, SERVICE_NAME,
# KAFKA_CONSUMER_GROUP and WARRANTY_SERVICE_URL are assigned per container
# in docker-compose.yml. Override them in a compose override for external infra.

# REST-only simulator starts automatically after apps and CDC initialization.
TRAFFIC_ENABLED=true
TRAFFIC_MODE=continuous
VIRTUAL_USERS=5
# TRAFFIC_CONCURRENCY is an alias when VIRTUAL_USERS is not set.
TRAFFIC_INTERVAL_MS=2000
TRAFFIC_ERROR_RATE=0.05
REQUEST_TIMEOUT_SECONDS=5
MAX_RETRIES=3
RETRY_BACKOFF_MS=200
DUPLICATE_REQUEST_RATE=0.05
DELETE_RATE=0.01
FAIL_INSPECTION_RATE=0.30
CONVERGENCE_TIMEOUT_SECONDS=45
FLOW_TIMEOUT_SECONDS=120
SUMMARY_INTERVAL_SECONDS=30
REPLICA_READ_DELAYS_MS=0,100,500,1000
# *_SERVICE_URL values use Docker DNS and are assigned in Compose.

# Observability: loopback UI ports; Grafana credentials apply on first volume initialization.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=lab_grafana_password
MONITORING_PASSWORD=monitoring_password
# Intentional consumer delay for lag labs (applies to Kafka handlers only).
SIMULATE_CONSUMER_DELAY_MS=0
# Bounded producer mode; false preserves normal end-to-end lifecycle traffic.
LOAD_TEST_MODE=false
LOAD_TEST_DURATION_SECONDS=180
LOAD_TEST_MAX_VEHICLES=1000
# cAdvisor auto-detects common Docker VM sockets. Override only if required.
CADVISOR_CONTAINERD_SOCKET=
CADVISOR_CONTAINERD_NAMESPACE=k8s.io
