FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/lab
WORKDIR /opt/lab
COPY requirements.lock /opt/requirements.lock
RUN pip install --no-cache-dir httpx==0.28.1 pydantic-settings==2.9.1 prometheus-client==0.22.1 -c /opt/requirements.lock && useradd --create-home traffic
COPY traffic_generator /opt/lab/traffic_generator
USER traffic
CMD ["python", "-m", "traffic_generator"]
