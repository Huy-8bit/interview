FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/common:/opt/lab
WORKDIR /opt/lab
COPY requirements.txt requirements.lock ./
RUN pip install --no-cache-dir -r requirements.txt -c requirements.lock && useradd --create-home lab
COPY common /opt/common
COPY scripts /opt/lab/scripts
COPY tests /opt/lab/tests
COPY pyproject.toml /opt/lab/
USER lab
CMD ["python", "scripts/demo.py"]
