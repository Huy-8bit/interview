    {
      "id": 3,
      "title": "Unreachable Cluster Peers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "description": "Non-zero on the surviving nodes while a peer is stopped or partitioned.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(node)(rabbitmq_unreachable_cluster_peers_count)"
