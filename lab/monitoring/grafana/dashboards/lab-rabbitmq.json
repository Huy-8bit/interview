    {
      "id": 16,
      "title": "Dead-letter Hops by Reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "description": "expired = a retry countdown hop through celery_delayed_*; rejected = worker gave up -> DLQ; delivery_limit = crash loop -> DLQ.",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum(rate(rabbitmq_global_messages_dead_lettered_rejected_total[2m])),\"reason\",\"rejected\",\"\",\"\") or label_replace(sum(rate(rabbitmq_global_messages_dead_lettered_delivery_limit_total[2m])),\"reason\",\"delivery_limit\",\"\",\"\") or label_replace(sum(rate(rabbitmq_global_messages_dead_lettered_expired_total[2m])),\"reason\",\"expired\",\"\",\"\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
