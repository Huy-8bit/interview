      "id": 18,
      "title": "Disk Free",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "description": "Below rabbitmq_disk_space_available_limit_bytes the disk alarm blocks publishers.",
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_disk_space_available_bytes"
        }
