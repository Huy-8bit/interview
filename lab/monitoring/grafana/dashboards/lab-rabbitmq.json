      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "description": "The node label shows the current Raft leader; it moves after the leader node stops.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_info{membership=\"leader\",queue=~\"inspection.report.(generate|dlq)\"}"
