{
  "uid": "lab-rabbitmq",
  "title": "RabbitMQ / Background Tasks",
  "tags": [
    "vehicle-lab"
  ],
  "schemaVersion": 40,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "RabbitMQ Node Up",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "description": "One series per node from the RabbitMQ Prometheus plugin scrape.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"rabbitmq\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Cluster Nodes Running",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "description": "Source: live Prometheus samples. Rate window 2m; scrape interval 10s.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"rabbitmq\"} == 1)"
