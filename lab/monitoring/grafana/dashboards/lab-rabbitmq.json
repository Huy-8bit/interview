    {
      "id": 17,
      "title": "Memory Used / High Watermark",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "description": "At 100% the memory alarm blocks publishers cluster-wide.",
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rabbitmq_process_resident_memory_bytes / rabbitmq_resident_memory_limit_bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
