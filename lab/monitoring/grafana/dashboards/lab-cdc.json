    {
      "id": 7,
      "title": "CDC Processing Lag \u2014 Source to C P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "description": "Source transaction timestamp to Inspection handler, including Kafka lag and intentional processing delay.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,connector)(rate(cdc_source_to_consumer_seconds_bucket[2m])))"
