      "id": 15,
      "title": "Service REST Errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "description": "Zero fallback only for service pairs with observed requests and no error series; missing scrapes still produce no data.",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,target_service,status_code)(rate(service_client_errors_total[2m])) or on(service,target_service) (0 * sum by(service,target_service)(rate(service_client_requests_total[2m])))"
        }
