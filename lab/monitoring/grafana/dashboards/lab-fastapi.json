    {
      "id": 3,
      "title": "Average Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "description": "Source: live Prometheus samples. Rate window 2m; scrape interval 10s.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(rate(http_request_duration_seconds_sum{service=~\"$service\",instance=~\"$instance\"}[2m])) / clamp_min(sum by(service)(rate(http_request_duration_seconds_count{service=~\"$service\",instance=~\"$instance\"}[2m])),0.001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
