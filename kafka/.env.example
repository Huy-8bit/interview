# ---- Kafka cluster ------------------------------------------------------------
KAFKA_VERSION=4.3.1
# KRaft cluster id (base64 UUID). Generate a new one with:
#   docker run --rm --entrypoint /opt/kafka/bin/kafka-storage.sh apache/kafka:4.3.1 random-uuid
# Changing it requires `make clean` (the data volumes are formatted with this id).
KAFKA_CLUSTER_ID=CPumNpgKS8u2KpUbNDseQA
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m

# ---- Producer service defaults (per-request overrides exist, see README) --------
PRODUCER_ACKS=all
PRODUCER_IDEMPOTENT=true
PRODUCER_COMPRESSION=lz4
PRODUCER_LINGER_MS=5
PRODUCER_BATCH_MAX_BYTES=1048576

# ---- order-consumer (consumer group: order-processing-group) --------------------
# manual | auto | auto-greedy | before-process     (see labs/07_offsets)
ORDER_COMMIT_MODE=manual
# cooperative-sticky | sticky | range | roundrobin  (see labs/06_rebalancing)
ORDER_BALANCER=cooperative-sticky
# classic | consumer (KIP-848, broker side assignment)
ORDER_GROUP_PROTOCOL=classic
ORDER_PROCESSING_DELAY_MS=0
ORDER_MAX_RETRIES=3

# ---- traffic generator (background traffic so dashboards always move) -----------
TRAFFIC_AUTOSTART=true
TRAFFIC_MODE=constant
TRAFFIC_RATE_PER_SECOND=5
TRAFFIC_DURATION=0s
