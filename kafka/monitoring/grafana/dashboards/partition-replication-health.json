  {
   "type": "timeseries",
   "title": "ISR shrinks / expands per minute",
   "description": "Shrink: a follower fell behind replica.lag.time.max.ms (10s here) or died. Expand: it caught up again.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (broker) (increase(kafka_server_replicamanager_isrshrinks_total[1m]))",
     "legendFormat": "shrink {{broker}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (broker) (increase(kafka_server_replicamanager_isrexpands_total[1m]))",
     "legendFormat": "expand {{broker}}"
    }
   ],
