  {
   "type": "timeseries",
   "title": "Broker FetchConsumer time p99",
   "description": "Includes fetch.max.wait when there is no new data (long polling) \u2014 high values on idle topics are normal.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 10,
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (broker) (kafka_network_requestmetrics_total_time_ms{request=\"FetchConsumer\",quantile=\"0.99\"})",
